# Match the Node runtime bundled by Electron 44.7.0. No SQLite network daemon:
# this container executes the production adapter against real local files.
FROM node:24.21.0-bookworm-slim
WORKDIR /workspace
RUN npm install --global pnpm@12.14.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY src ./src
COPY tests ./tests
COPY scripts/build-sqlite-worker.mjs scripts/build-windows-owner-guard.mjs ./scripts/
COPY vitest.config.ts tsconfig.json ./
RUN node scripts/build-sqlite-worker.mjs
ENV SQLCOMMANDER_TEST_DRIVERS=sqlite
CMD ["pnpm", "exec", "vitest", "run", "tests/integration/sqlite.test.ts"]
