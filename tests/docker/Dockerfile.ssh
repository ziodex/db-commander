FROM alpine:3.22
RUN apk add --no-cache openssh && adduser -D tunnel && echo 'tunnel:local-ssh-only' | chpasswd && mkdir -p /run/sshd /home/tunnel/.ssh /fixture
COPY tests/docker/sshd_config /etc/ssh/sshd_config
COPY --chmod=755 tests/docker/ssh-entrypoint.sh /usr/local/bin/ssh-fixture
ENTRYPOINT ["/usr/local/bin/ssh-fixture"]
